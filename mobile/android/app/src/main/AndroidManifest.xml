<?xml version="1.0" encoding="utf-8"?>
<!--
  SVCS Mobile - manifest.

  Permissions are deliberately minimal. No location, no camera, no contacts,
  and no storage permission: the compressor reads only videos the user picks
  or shares in (a per-file grant), and writes its output through MediaStore,
  which needs no permission on API 29+.

  - INTERNET, ACCESS_NETWORK_STATE: Server Mode only. The app talks to the
    one server the user names; the network-state check lets the pairing
    screen tell "you are offline" from "that address is wrong".
  - POST_NOTIFICATIONS: compression progress and server job alerts.
  - FOREGROUND_SERVICE(_MEDIA_PROCESSING): keeps an on-device encode alive
    when the app goes to the background.
  - REQUEST_INSTALL_PACKAGES (Fall 3.18): lets the app hand a downloaded
    update APK to the system package installer without a separate consent
    dialog every time. This is ONLY ever exercised for a sideloaded install
    that the user explicitly asked to update in-app (org.svcs.mobile.update);
    it is a no-op for an F-Droid install, which never reaches that code path
    at all (see UpdateManager's doc comment) since F-Droid manages its own
    updates. The user still separately grants "install unknown apps" for
    this app the first time (Settings.ACTION_MANAGE_UNKNOWN_APP_SOURCES,
    launched from the update UI, not silently).

  Author: Bloodawn (KheivenD), 2026-07-18 (M1.1); updated 2026-09-24 for the
  standalone compressor and the Fall 3.18 auto-update pipeline.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- M5 slice: a system notification when a server job finishes. Runtime
         permission on Android 13+; declining simply means no notifications. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Fall roadmap Phase 1: the standalone on-device compressor runs as a
         mediaProcessing foreground service (Android 14+) so the OS does not
         kill a multi-minute encode the moment the app backgrounds. See
         STANDALONE-COMPRESSOR-ROADMAP.md section 4, Phase 1 - this is the
         one Play-relevant permission a fully open-source, no-store-required
         app still needs at the OS level, independent of any store. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROCESSING" />

    <!-- Fall 3.18: direct-APK-sideload auto-update (see the block comment
         above and org.svcs.mobile.update.UpdateManager). -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <application
        android:name=".SvcsApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:networkSecurityConfig="@xml/network_security_config"
        android:theme="@style/Theme.SVCS">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:theme="@style/Theme.SVCS">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Fall roadmap Phase 1: "Share -> SVCS" from the gallery or any
                 app that hands out a video, straight into the COMPRESS tab.
                 The sender's read grant covers this app while the receiving
                 task is alive, which spans the compression job. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="video/*" />
            </intent-filter>
        </activity>

        <!-- Merge the mediaProcessing foreground-service type onto WorkManager's
             own service, which is what actually runs CompressionWorker's
             setForeground() call. Declaring it here AND at runtime (see
             CompressionWorker.buildForegroundInfo) is what the platform
             requires - the manifest declaration alone is not enough. -->
        <service
            android:name="androidx.work.impl.foreground.SystemForegroundService"
            android:foregroundServiceType="mediaProcessing"
            tools:node="merge" />

        <!-- Fall 3.18: exposes only getExternalFilesDir()/updates/ (where
             UpdateManager downloads and verifies a new APK) as a content://
             URI, so the system package installer can read it without this
             app granting broader file access. See res/xml/file_paths.xml
             and org.svcs.mobile.update.UpdateManager.installReadyUpdate. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
