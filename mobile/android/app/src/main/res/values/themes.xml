<?xml version="1.0" encoding="utf-8"?>
<!-- Dark-only, matching the design system. The Compose theme in
     ui/theme/Theme.kt carries the real palette; this is just the launch
     window so there is no white flash before Compose draws. -->
<resources>
    <style name="Theme.SVCS" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">#0a0e14</item>
        <item name="android:statusBarColor">#0a0e14</item>
        <item name="android:navigationBarColor">#0a0e14</item>
    </style>
</resources>
