# Copy this file to .env (kept out of git by web/.gitignore) and fill in the
# two values from your Supabase project's Settings -> API page.
#
# VITE_SUPABASE_ANON_KEY is safe to ship in a static site: it can only do
# what the Postgres row-level-security policies in supabase/schema.sql allow
# it to do. It is NOT the service-role key - never put that in this file or
# in anything Netlify serves to the browser.
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY
